openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
base = base_sect
fips = fips_sect
cygnet = sso_labs_sect

[base_sect]
activate = 1

[fips_sect]
activate = 1
module = /usr/lib/x86_64-linux-gnu/ossl-modules-3/fips.so

[sso_labs_sect]
activate = 1
module = /home/cyadmin/cygnet-provider/build/provider/cygnetprov.so
